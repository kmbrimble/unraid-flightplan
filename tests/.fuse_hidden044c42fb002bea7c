t('first sync swaps a marker-owned folder into place; nothing is left in staging', function () use ($FAKE) {
    $sb = sandbox();
    $zip = make_zip("$sb[base]/a.zip", ['a.xml' => tpl(), 'sub/b.xml' => tpl('x/y')]);
    fake_set(['o/r' => ['branches' => ['main' => gsha('1')], 'zip' => $zip]]);
    setup_config([src()]);
    $r = fp_sync_all('test');
    assert_true($r['ok'], 'sync failed');
    assert_true(is_file("$sb[private]/r/a.xml") && is_file("$sb[private]/r/b.xml"), 'templates missing');
    assert_true(fp_is_owned("$sb[private]/r"), 'marker missing');
    assert_eq([], array_values(array_diff(scandir($sb['stage']) ?: [], ['.', '..'])), 'staging not cleaned');
    $st = fp_state_load();
    $s = array_values($st['sources'])[0];
    assert_eq('updated', $s['status']);
    assert_eq(2, $s['count']);
    assert_eq('main', $s['branch'], 'default branch not resolved');
    assert_eq(gsha('1'), $s['sha']);
});

