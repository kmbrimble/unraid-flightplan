/** Fresh sandbox; points every FLIGHTPLAN_* path at it. Private + stage + state share one filesystem. */
function sandbox(): array
{
    $base = sys_get_temp_dir() . '/fp-test-' . bin2hex(random_bytes(5));
    foreach (['private', 'stage', 'state', 'emhttp'] as $d) {
        mkdir("$base/$d", 0755, true);
    }
    $sb = ['base' => $base, 'private' => "$base/private", 'stage' => "$base/stage", 'state' => "$base/state", 'config' => "$base/flightplan.json",
        'cron' => "$base/flightplan.cron"];
    putenv('FLIGHTPLAN_PRIVATE_DIR=' . $sb['private']);
    putenv('FLIGHTPLAN_STAGE_DIR=' . $sb['stage']);
    putenv('FLIGHTPLAN_STATE_DIR=' . $sb['state']);
    putenv('FLIGHTPLAN_CONFIG=' . $sb['config']);
    putenv('FLIGHTPLAN_CRON_FILE=' . $sb['cron']);
    putenv('FLIGHTPLAN_UPDATE_CRON=-');
    putenv('FLIGHTPLAN_SECRETSMAN_SRC=' . __DIR__ . '/fixtures/secretsman-stub.php');
    putenv('SECRETSMAN_STORE_PATH=' . "$base/store.json");
    return $sb;
}

function free_port(): int
{
    $s = stream_socket_server('tcp://127.0.0.1:0');
    $name = stream_socket_get_name($s, false);
    fclose($s);
    return (int) substr($name, strrpos($name, ':') + 1);
}

