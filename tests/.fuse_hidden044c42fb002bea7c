    assert_eq(1, $calls(), 'the synchronous registration should have reloaded cron once');
    usleep(1500000);
    assert_eq(1, $calls(), 'reloaded again before the plugin was registered');
    touch($link); // the plugin manager creates /var/log/plugins/flightplan.plg after the install script returns
    $ok = false;
    for ($i = 0; $i < 40 && !$ok; $i++) {
        usleep(250000);
        $ok = $calls() >= 2;
    }
    assert_true($ok, 'cron was not reloaded after the plugin registered, so the schedule would stay inactive until the next reload');
    // a plugin with no schedule must not leave a waiting process or reload anything
    unlink($link);
    setup_config([], ['schedule_enabled' => false]);
    $p = proc_open(['/bin/bash', "$repoRoot/plugin/scripts/after-install.sh"], [1 => ['pipe', 'w'], 2 => ['pipe', 'w']], $pipes, null, array_merge(getenv(), $env));
    stream_get_contents($pipes[1]);
    stream_get_contents($pipes[2]);
    proc_close($p);
    @unlink($rec); // the synchronous pass legitimately removed the old cron file and reloaded once
    touch($link);
    usleep(2500000);
    assert_eq(0, $calls(), 'reloaded cron although there is no schedule');
});

t('package: layout, executable event hook, stock README shape, deterministic bytes', function () use ($repoRoot, $plgRaw) {
    preg_match('/<!ENTITY version\s+"([^"]+)">/', $plgRaw, $v);
    $ver = $v[1];
    $build = function (string $umask, array $env) use ($repoRoot, $ver): string {
        $cmd = sprintf('umask %s; bash %s %s > /dev/null && md5sum %s | cut -d" " -f1', $umask, escapeshellarg("$repoRoot/scripts/build-plugin.sh"), escapeshellarg($ver), escapeshellarg("$repoRoot/dist/flightplan-$ver.txz"));
        $p = proc_open(['/bin/bash', '-c', $cmd], [1 => ['pipe', 'w'], 2 => ['pipe', 'w']], $pipes, null, array_merge(getenv(), $env));
        $o = trim(stream_get_contents($pipes[1]));
        $e = stream_get_contents($pipes[2]);
        proc_close($p);
        assert_true(preg_match('/^[0-9a-f]{32}$/', $o) === 1, "build failed: $e");
        return $o;
    };
    $a = $build('022', ['TZ' => 'UTC', 'XZ_DEFAULTS' => '']);
    $b = $build('077', ['TZ' => 'Pacific/Auckland', 'XZ_DEFAULTS' => '--threads=4']);
    assert_eq($a, $b, 'build is not reproducible across umask/TZ/XZ_DEFAULTS');
    $list = shell_exec('tar -tvJf ' . escapeshellarg("$repoRoot/dist/flightplan-$ver.txz")) ?: '';
    foreach (explode("\n", trim($list)) as $line) {
        $path = preg_split('/\s+/', $line)[5] ?? '';
        assert_true(str_starts_with($path . '/', 'usr/') && (str_starts_with($path, 'usr/local/emhttp/plugins/flightplan') || in_array(rtrim($path, '/'), ['usr', 'usr/local', 'usr/local/emhttp', 'usr/local/emhttp/plugins'], true)), "path outside the plugin dir: $line");
    }
    assert_true(preg_match('~^-rwx\S+\s+0/0\s.*plugins/flightplan/event/started$~m', $list) === 1, 'event/started not executable');
    assert_true(preg_match('~^-rw-r--r--\s+0/0\s.*plugins/flightplan/Flightplan\.page$~m', $list) === 1, 'page mode');
    assert_true(str_contains($list, 'plugins/flightplan/Flightplan.page'), 'page must sit at the plugin root');
    $readme = (string) file_get_contents("$repoRoot/plugin/README.md");
    assert_true(preg_match('/^\*\*Flightplan\*\*\n\n[^\n#]+\n?$/', $readme) === 1, 'plugin/README.md is not in the stock shape');
    $md5 = null;
    preg_match('/<!ENTITY md5\s+"([^"]+)">/', $plgRaw, $m);
    // The committed md5 is enforced by scripts/check-md5.sh in CI (release readiness); here only record the build.
    fwrite(STDERR, "  (built flightplan-$ver.txz md5 $a; .plg has $m[1])\n");
});

