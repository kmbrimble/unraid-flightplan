t('plg install and remove blocks run clean against stubs, and a sync problem never fails the install', function () use ($plgPath, $repoRoot) {
    $sb = sandbox();
    $x = simplexml_load_file($plgPath, \SimpleXMLElement::class, LIBXML_NOENT);
    $blocks = [];
    foreach ($x->FILE as $f) {
        if (isset($f->INLINE)) {
            $blocks[(string) ($f['Method'] ?? 'install')] = (string) $f->INLINE;
        }
    }
    assert_true(isset($blocks['install'], $blocks['remove']), 'blocks not found');
    $root = "$sb[base]/root";
    $flash = "$root/boot/config/plugins/flightplan";
    $emhttp = "$root/usr/local/emhttp/plugins/flightplan";
    $bin = "$root/bin";
    mkdir($bin, 0755, true);
    mkdir("$root/varlog", 0755, true);
    foreach (['upgradepkg', 'removepkg'] as $cmd) {
        file_put_contents("$bin/$cmd", "#!/bin/bash\necho \"$cmd \$*\" >> \"$root/calls.log\"\nif [[ \"\$1\" == --install-new ]]; then mkdir -p $emhttp; cp -a $repoRoot/plugin/. $emhttp/; fi\nexit 0\n");
        chmod("$bin/$cmd", 0755);
    }
    mkdir($flash, 0755, true);
    file_put_contents("$flash/flightplan-0.0.9.txz", 'old');
    file_put_contents("$flash/flightplan-0.1.0.txz", 'cur');
    file_put_contents("$flash/flightplan.json", '{"unrelated":1}');
    $subst = fn(string $s): string => str_replace(['/boot/config/plugins/flightplan', '/usr/local/emhttp/plugins/flightplan', '/var/log/packages'], [$flash, $emhttp, "$root/varlog"], $s);
    $env = ['PATH' => "$bin:" . getenv('PATH'), 'FLIGHTPLAN_EMHTTP' => $emhttp, 'FLIGHTPLAN_VAR_INI' => "$root/var.ini", 'FLIGHTPLAN_SYNC_SCRIPT' => "$emhttp/scripts/flightplan-sync.php"];
    $run = function (string $script, array $e) use ($root): array {
        file_put_contents("$root/block.sh", $script);
        $p = proc_open(['/bin/bash', "$root/block.sh"], [1 => ['pipe', 'w'], 2 => ['pipe', 'w']], $pipes, null, array_merge(getenv(), $e));
        $o = stream_get_contents($pipes[1]) . stream_get_contents($pipes[2]);
        return [proc_close($p), $o];
    };
    // array not started: install must succeed, defer the sync, keep only the current txz, leave the config alone
    file_put_contents("$root/var.ini", "mdState=\"STOPPED\"\n");
    [$code, $out] = $run($subst($blocks['install']), $env);
    assert_eq(0, $code, $out);
    assert_true(str_contains($out, 'array not started'), $out);
    assert_true(!is_file("$flash/flightplan-0.0.9.txz") && is_file("$flash/flightplan-0.1.0.txz"), 'old txz handling');
    assert_eq('{"unrelated":1}', file_get_contents("$flash/flightplan.json"), 'install touched the config');
    assert_true(is_file("$emhttp/event/started") && is_executable("$emhttp/event/started"));
    // array started, valid config pointing at a dead forge: still exit 0 (the sync runs detached)
    file_put_contents("$root/var.ini", "mdState=\"STARTED\"\n");
    $dead = free_port();
    file_put_contents("$flash/flightplan.json", json_encode(['schedule_enabled' => false, 'schedule' => '0 3 * * *', 'sources' => [['id' => 'abcd1234', 'forge' => 'gitea', 'base_url' => "http://127.0.0.1:$dead", 'repo' => 'o/r', 'name' => 'r']]]));
    $env2 = $env + ['FLIGHTPLAN_CONFIG' => "$flash/flightplan.json"];
    [$code, $out] = $run($subst($blocks['install']), $env2);
    assert_eq(0, $code, $out);
    assert_true(str_contains($out, 'first sync started'), $out);
    // remove block
    owned_dir($sb['private'], 'r');
    [$code, $out] = $run($subst($blocks['remove']), $env2);
    assert_eq(0, $code, $out);
    assert_true(!is_dir($emhttp) && !is_dir("$sb[private]/r"), 'remove left the tree or owned folders behind');
    assert_true(is_file("$flash/flightplan.json"), 'remove deleted the user config');
    assert_true(!is_file("$flash/flightplan-0.1.0.txz"));
});

