t('duplicate basenames are resolved deterministically and logged; ca_profile and dot-dirs are skipped', function () {
    $sb = sandbox();
    $files = [
        'z/dup.xml' => tpl('z/dup'), 'a/dup.xml' => tpl('a/dup'), 'top/deep/dup.xml' => tpl('deep/dup'), 'DUP.XML' => tpl('upper/dup'),
        'ca_profile.xml' => '<Profile/>', 'sub/CA_Profile.xml' => '<Profile/>', '.github/hidden.xml' => tpl('hid'), 'ok/.cache/x.xml' => tpl('hid2'),
        'solo.xml' => tpl('solo'), 'notes.txt' => 'no',
    ];
    fake_set(['o/r' => ['branches' => ['main' => gsha('1')], 'zip' => make_zip("$sb[base]/a.zip", $files)]]);
    setup_config([src()]);
    fp_sync_all('test');
    $got = array_values(array_diff(scandir("$sb[private]/r") ?: [], ['.', '..', FP_MARKER]));
    sort($got);
    assert_eq(['DUP.XML', 'solo.xml'], $got, 'unexpected file set (shallowest path wins, case-insensitive)');
    assert_true(str_contains((string) file_get_contents("$sb[private]/r/DUP.XML"), 'upper/dup'));
    $s = array_values(fp_state_load()['sources'])[0];
    $dups = array_filter($s['notes'], fn($n) => str_contains($n, 'duplicate file name'));
    assert_eq(3, count($dups), 'duplicates not logged: ' . json_encode($s['notes']));
    // determinism: the same archive again gives the same result
    $first = tree_text("$sb[private]/r");
    fp_rmtree("$sb[private]/r");
    fp_sync_all('test');
    $a = array_values(array_diff(scandir("$sb[private]/r") ?: [], ['.', '..', FP_MARKER]));
    sort($a);
    assert_eq($got, $a);
});

