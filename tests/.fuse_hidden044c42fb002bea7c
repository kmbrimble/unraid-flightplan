function with_store(array $sb, array $data): void
{
    file_put_contents("$sb[base]/store.json", json_encode($data));
    chmod("$sb[base]/store.json", 0600);
}

function proc_exposure(string $needle): array
{
    $hits = [];
    foreach (glob('/proc/[0-9]*') ?: [] as $d) {
        foreach (['cmdline', 'environ'] as $f) {
            $c = @file_get_contents("$d/$f");
            if ($c !== false && str_contains($c, $needle)) {
                $hits[] = basename($d) . '/' . $f;
            }
        }
    }
    return $hits;
}

