    $token = 'FPTEST-' . bin2hex(random_bytes(12));
    with_store($sb, ['forge' => ['reader' => $token]]);
    $zip = make_zip("$sb[base]/a.zip", ['a.xml' => tpl()]);
    fake_set(['o/r' => ['branches' => ['main' => gsha('1')], 'zip' => $zip, 'token' => $token, 'archive_delay_ms' => 1500]]);
    setup_config([src(['token_ref' => '!secret forge/reader'])]);
    $p = proc_open([PHP_BINARY, "$repoRoot/plugin/scripts/flightplan-sync.php", '--manual'], [0 => ['file', '/dev/null', 'r'], 1 => ['pipe', 'w'], 2 => ['pipe', 'w']], $pipes, null, getenv());
    stream_set_blocking($pipes[1], false);
    $seen = 0;
    $exposure = [];
    $deadline = microtime(true) + 20;
    while (microtime(true) < $deadline) {
        $st = proc_get_status($p);
        if (!$st['running']) {
            break;
        }
        if (count(array_filter(fake_log(), fn($r) => str_contains($r['path'], '/archive/'))) > 0) {
            $seen++;
            $exposure = array_merge($exposure, proc_exposure($token));
        }
        usleep(100000);
    }
    $out = stream_get_contents($pipes[1]) . stream_get_contents($pipes[2]);
    $code = proc_close($p);
    assert_true($seen >= 3, "did not sample the process while it held the token ($seen samples)");
    assert_eq([], array_values(array_unique($exposure)), 'token visible in /proc');
    assert_true(is_file("$sb[private]/r/a.xml"), 'sync did not complete (exit ' . $code . '): ' . $out);
    // non-vacuous: the server really received the credential, on the API calls and on the archive
    $authed = array_filter(fake_log(), fn($r) => $r['auth'] === 'token ' . $token);
    assert_true(count($authed) >= 3, 'forge never received the token (' . count($authed) . ' authenticated requests)');
    foreach ([$out, tree_text($sb['state']), tree_text($sb['private']), tree_text($sb['stage']), json_encode(fp_status()), (string) file_get_contents($sb['config'])] as $i => $blob) {
        assert_true(!str_contains($blob, $token), "token found in artefact #$i");
    }
});

