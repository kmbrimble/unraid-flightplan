t('cron registration writes the flash file only when it changes, and ALWAYS reloads cron while a schedule exists', function () {
    $sb = sandbox();
    $rec = "$sb[base]/update_cron.calls";
    file_put_contents("$sb[base]/update_cron", "#!/bin/bash\necho call >> '$rec'\n");
    chmod("$sb[base]/update_cron", 0755);
    putenv('FLIGHTPLAN_UPDATE_CRON=' . "$sb[base]/update_cron");
    $calls = fn(): int => is_file($rec) ? count(file($rec)) : 0;
    $cfg = ['schedule_enabled' => true, 'schedule' => '17 */4 * * *'];
    assert_eq([true, 'schedule registered'], fp_cron_register($cfg));
    assert_eq(1, $calls());
    $line = trim(explode("\n", (string) file_get_contents($sb['cron']))[1]);
    assert_true(str_starts_with($line, '17 */4 * * * php ') && str_ends_with($line, '--cron > /dev/null 2>&1'), $line);
    $ino = fileinode($sb['cron']);
    clearstatcache();
    // the boot case: the flash file is already right but the RAM crontab was wiped, so cron must still be reloaded
    assert_eq([true, 'schedule unchanged'], fp_cron_register($cfg));
    assert_eq(2, $calls(), 'cron not reloaded when the flash file already matched');
    clearstatcache();
    assert_eq($ino, fileinode($sb['cron']), 'rewritten although unchanged');
    assert_eq([true, 'schedule removed'], fp_cron_register(['schedule_enabled' => false, 'schedule' => '']));
    assert_eq(3, $calls(), 'cron not reloaded after removing the entry');
    assert_true(!is_file($sb['cron']));
    assert_eq([true, 'schedule off'], fp_cron_register(['schedule_enabled' => false, 'schedule' => '']));
    assert_eq(3, $calls(), 'reloaded although there never was an entry');
    putenv('FLIGHTPLAN_UPDATE_CRON=-');
});

