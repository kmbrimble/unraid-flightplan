function fake_set(array $repos): void
{
    global $FAKE;
    file_put_contents($FAKE['dir'] . '/mode.json', json_encode(['repos' => $repos]));
    @unlink($FAKE['dir'] . '/requests.log');
}

function fake_log(): array
{
    global $FAKE;
    $f = $FAKE['dir'] . '/requests.log';
    return is_file($f) ? array_map(fn($l) => json_decode($l, true), array_filter(explode("\n", (string) file_get_contents($f)))) : [];
}

function fake_archive_hits(): int
{
    return count(array_filter(fake_log(), fn($r) => preg_match('~/(archive|zipball)/~', $r['path']) === 1));
}

/** Build a zip with the given files under a single top-level directory, the way Gitea/GitHub archives look. */
function make_zip(string $path, array $files, string $top = 'repo'): string
{
    $z = new \ZipArchive();
    $z->open($path, \ZipArchive::CREATE | \ZipArchive::OVERWRITE);
    $z->addEmptyDir($top);
    foreach ($files as $name => $content) {
        $z->addFromString($top . '/' . $name, $content);
    }
    $z->close();
    return $path;
}

function tpl(string $repository = 'lscr.io/linuxserver/example', string $extra = ''): string
{
    return '<?xml version="1.0"?><Container version="2"><Name>Example</Name><Repository>' . $repository . '</Repository>'
        . '<Overview>Mentions github.com in prose only.</Overview>' . $extra . '</Container>';
}

function gsha(string $seed): string
{
    return substr(hash('sha256', $seed), 0, 40);
}

function src(array $o = []): array
{
    global $PORT;
    return array_merge(['forge' => 'gitea', 'base_url' => "http://127.0.0.1:$PORT", 'repo' => 'o/r', 'branch' => '', 'subpath' => '', 'name' => '', 'token_ref' => ''], $o);
}

function setup_config(array $sources, array $extra = []): array
{
    [$ok, $msg, $cfg] = fp_config_save(array_merge(['schedule_enabled' => false, 'schedule' => '0 */6 * * *', 'sources' => $sources], $extra));
    assert_true($ok, 'config rejected: ' . $msg);
    return $cfg;
}

/** Run a PHP script as a real subprocess. Returns [exit, stdout, stderr]. */
function run_php(array $args, array $env = [], string $stdin = ''): array
{
    $p = proc_open(array_merge([PHP_BINARY], $args), [0 => ['pipe', 'r'], 1 => ['pipe', 'w'], 2 => ['pipe', 'w']], $pipes, null, array_merge(getenv(), $env));
    fwrite($pipes[0], $stdin);
    fclose($pipes[0]);
    $out = stream_get_contents($pipes[1]);
    $err = stream_get_contents($pipes[2]);
    return [proc_close($p), $out, $err];
}

function tree_text(string $dir): string
{
    $all = '';
    foreach (is_dir($dir) ? (scandir($dir) ?: []) : [] as $e) {
        if ($e === '.' || $e === '..') {
            continue;
        }
        $p = "$dir/$e";
        $all .= is_dir($p) ? tree_text($p) : $e . "\n" . file_get_contents($p) . "\n";
    }
    return $all;
}

function owned_dir(string $private, string $name, array $files = ['keep.xml' => '<Container/>']): void
{
    mkdir("$private/$name", 0755, true);
    foreach ($files as $f => $c) {
        file_put_contents("$private/$name/$f", $c);
    }
    file_put_contents("$private/$name/" . FP_MARKER, json_encode(['tool' => 'flightplan', 'source' => 'zzzz0000']) . "\n");
}

