t('vendored design files carry the provenance header and the UI uses no raw colour values', function () use ($repoRoot) {
    foreach (['tokens', 'base', 'components'] as $f) {
        $first = (string) strtok((string) file_get_contents("$repoRoot/plugin/app/assets/$f.css"), "\n");
        assert_true(preg_match('~^/\* vendored from kmbrimble/design-system@[0-9a-f]{7,} — do not edit, change upstream \*/$~u', $first) === 1, "$f.css header");
    }
    $css = (string) file_get_contents("$repoRoot/plugin/app/assets/app.css");
    assert_true(!preg_match('/#[0-9a-fA-F]{3,8}\b|rgba?\(|hsla?\(/', $css), 'raw colour in app.css');
    foreach (array_unique(array_map(fn($m) => $m, (function () use ($css) { preg_match_all('/var\((--[a-z0-9-]+)\)/', $css, $m); return $m[1]; })())) as $tok) {
        assert_true(str_contains((string) file_get_contents("$repoRoot/plugin/app/assets/tokens.css"), "$tok:"), "undefined token $tok");
    }
});

