<?php
// Thin host for the Flightplan web app (plugins/flightplan/app/), served by the webGUI itself so it shares the
// session and CSRF handling. No config access and no markup of its own: the whole UI is the iframe, and the same
// URL opens standalone via "Open full page". Same pattern as SecretsMan.
$app = '/plugins/flightplan/app/index.php';
?>
<style>
  #fp-frame-bar { display: flex; justify-content: flex-end; margin: 0 0 6px; }
  #fp-frame { display: block; width: 100%; height: 70vh; border: 0; background: transparent; }
</style>
<div id="fp-frame-bar"><a href="<?= $app ?>" target="_blank" rel="noopener">Open full page</a></div>
<iframe id="fp-frame" title="Flightplan" src="<?= $app ?>"></iframe>
<script>
(function () {
  'use strict';
  // Fill the viewport below the Unraid header so the app scrolls inside the frame and the page itself does not.
  var frame = document.getElementById('fp-frame');
  function fit() {
    var footer = document.getElementById('footer');
    var below = footer && getComputedStyle(footer).position === 'fixed' ? footer.offsetHeight : 0;
    var h = window.innerHeight - frame.getBoundingClientRect().top - below - 8;
    frame.style.height = Math.max(320, h) + 'px';
    var over = document.documentElement.scrollHeight - window.innerHeight;
    if (over > 0) frame.style.height = Math.max(320, frame.offsetHeight - over) + 'px';
  }
  window.addEventListener('resize', fit);
  window.addEventListener('load', fit);
  fit();
  setTimeout(fit, 400);
})();
</script>
